# Copy to .env.local and fill in. Never commit real values.
# Local values come from `npx supabase status -o env`.

# Public: inlined into the browser bundle. Safe to expose; RLS governs access.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SERVER-ONLY. Bypasses RLS. Never prefix with NEXT_PUBLIC_, never import from
# app/. Read via lib/server-env.ts (minting sign-in links) and by scripts/seed.mts.
# Locally: the SECRET_KEY from supabase status.
SUPABASE_SERVICE_ROLE_KEY=

# Origin that sign-in links point at. Required in production (never derived
# from the request Host header). Defaults to http://127.0.0.1:3000 in dev.
SITE_URL=http://127.0.0.1:3000

# How sign-in links are delivered: console (print to server log), mailpit
# (local inbox at :54324), smtp (production), or appsScript (alternative).
# Defaults to console in dev; must be set in production and on Vercel
# previews, where console and mailpit refuse to run.
AUTH_LINK_SENDER=console
# MAILPIT_URL=http://127.0.0.1:54324

# Gmail SMTP (AUTH_LINK_SENDER=smtp). SERVER-ONLY. The password is a Google
# App Password for SMTP_USER, never the account password. Gmail sends From
# SMTP_USER, so SMTP_FROM_NAME is the display name people see.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=SCU ACM
SMTP_REPLY_TO=

# Google Apps Script web app (AUTH_LINK_SENDER=appsScript), the alternative
# sender: a trial Workspace caps it at 100 recipients/day. SERVER-ONLY.
APPS_SCRIPT_URL=
APPS_SCRIPT_SECRET=

# Dry runs on Preview only: deliver every link to one of these inboxes
# (comma-separated) instead of its recipient. Refused on production.
# AUTH_LINK_REDIRECT_TO=

# Optional, for `npm run seed`: this email is made an organizer.
SEED_ORGANIZER_EMAIL=organizer@example.com
